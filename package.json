{
"name": "nexusflow-erp-crm-api",
"version": "1.0.0",
"description": "NexusFlow ERP + CRM Operations Portal API",
"main": "dist/server.js",
"scripts": {
"dev": "ts-node-dev --respawn --transpile-only src/server.ts",
"build": "tsc && node scripts/copy-static.mjs",
"start": "node dist/server.js",
"migrate": "ts-node src/db/migrate.ts",
"seed": "ts-node src/db/seed.ts",
"migrate:prod": "node dist/db/migrate.js",
"seed:prod": "node dist/db/seed.js"
},
"dependencies": {
"bcryptjs": "2.4.3",
"cors": "2.8.5",
"dotenv": "16.4.5",
"express": "4.22.2",
"jsonwebtoken": "9.0.2",
"pg": "8.12.0",
"zod": "3.23.8"
},
"devDependencies": {
"@types/bcryptjs": "2.4.6",
"@types/cors": "2.8.17",
"@types/express": "4.17.21",
"@types/jsonwebtoken": "9.0.6",
"@types/node": "20.14.9",
"@types/pg": "8.11.6",
"ts-node": "10.9.2",
"ts-node-dev": "2.0.0",
"typescript": "5.5.3"
},
"engines": {
"node": ">=20 <25",
"npm": ">=10"
}
}
