# PostgreSQL connection string.
# Local example: postgresql://postgres:postgres@localhost:5432/mini_erp
# Neon/Supabase/Render will give you a full connection string to paste here.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mini_erp"
# Any long random string. You can generate one with: openssl rand -base64 32
JWT_SECRET="change-this-to-a-long-random-secret"
# Port the API server listens on
PORT=4000
# Comma-separated list of allowed frontend origins (for CORS)
CORS_ORIGIN="http://localhost:5173"
