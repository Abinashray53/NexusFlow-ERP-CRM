{
"info": {
"name": "NexusFlow ERP + CRM API",
"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
},
"variable": [
{ "key": "baseUrl", "value": "http://localhost:4000" },
{ "key": "token", "value": "" },
{ "key": "customerId", "value": "" },
{ "key": "productId", "value": "" },
{ "key": "challanId", "value": "" }
],
"item": [
{
"name": "Auth",
"item": [
{
"name": "Login (Admin)",
"request": {
"method": "POST",
"header": [{ "key": "Content-Type", "value": "application/json" }],
"body": { "mode": "raw", "raw": "{\n \"email\": \"admin@minierp.test\",\n \"password\": \"Password123!\"\n}" },
"url": "{{baseUrl}}/auth/login"
}
},
{
"name": "Get current user",
"request": {
"method": "GET",
"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
"url": "{{baseUrl}}/auth/me"
}
}
]
},
{
"name": "Customers",
"item": [
{
"name": "List customers",
"request": {
"method": "GET",
"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
"url": "{{baseUrl}}/customers?page=1&limit=20&search=&status="
}
},
{
"name": "Create customer",
"request": {
"method": "POST",
"header": [
{ "key": "Content-Type", "value": "application/json" },
{ "key": "Authorization", "value": "Bearer {{token}}" }
],
"body": {
"mode": "raw",
"raw": "{\n \"name\": \"Ramesh Traders\",\n \"mobile\": \"9876543210\",\n \"email\": \"ramesh@traders.test\",\n \"businessName\": \"Ramesh Traders Pvt Ltd\",\n \"customerType\": \"WHOLESALE\",\n \"status\": \"ACTIVE\",\n \"address\": \"MG Road, Bhubaneswar\"\n}"
},
"url": "{{baseUrl}}/customers"
}
},
{
"name": "Get customer detail",
"request": {
"method": "GET",
"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
"url": "{{baseUrl}}/customers/{{customerId}}"
}
},
{
"name": "Update customer",
"request": {
"method": "PUT",
"header": [
{ "key": "Content-Type", "value": "application/json" },
{ "key": "Authorization", "value": "Bearer {{token}}" }
],
"body": { "mode": "raw", "raw": "{\n \"status\": \"ACTIVE\"\n}" },
"url": "{{baseUrl}}/customers/{{customerId}}"
}
},
{
"name": "Add follow-up note",
"request": {
"method": "POST",
"header": [
{ "key": "Content-Type", "value": "application/json" },
{ "key": "Authorization", "value": "Bearer {{token}}" }
],
"body": { "mode": "raw", "raw": "{\n \"note\": \"Called, interested in bulk order\"\n}" },
"url": "{{baseUrl}}/customers/{{customerId}}/notes"
}
}
]
},
{
"name": "Products",
"item": [
{
"name": "List products",
"request": {
"method": "GET",
"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
"url": "{{baseUrl}}/products?page=1&limit=20&search=&lowStock=false"
}

},
{
"name": "Create product",
"request": {
"method": "POST",
"header": [
{ "key": "Content-Type", "value": "application/json" },
{ "key": "Authorization", "value": "Bearer {{token}}" }
],
"body": {
"mode": "raw",
"raw": "{\n \"name\": \"Steel Rod 10mm\",\n \"sku\": \"SKU-STEEL-001\",\n \"category\": \"Raw Material\",\n \"unitPrice\": 450,\n \"currentStock\": 200,\n \"minStockAlert\": 20,\n \"location\": \"Warehouse A\"\n}"
},
"url": "{{baseUrl}}/products"
}
},
{
"name": "Get product detail (with movement log)",
"request": {
"method": "GET",
"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
"url": "{{baseUrl}}/products/{{productId}}"
}
},
{
"name": "Update product",
"request": {
"method": "PUT",
"header": [
{ "key": "Content-Type", "value": "application/json" },
{ "key": "Authorization", "value": "Bearer {{token}}" }
],
"body": { "mode": "raw", "raw": "{\n \"unitPrice\": 475\n}" },
"url": "{{baseUrl}}/products/{{productId}}"
}
},
{
"name": "Record stock movement (IN/OUT)",
"request": {
"method": "POST",
"header": [
{ "key": "Content-Type", "value": "application/json" },
{ "key": "Authorization", "value": "Bearer {{token}}" }
],
"body": {
"mode": "raw",
"raw": "{\n \"quantity\": 50,\n \"movementType\": \"IN\",\n \"reason\": \"New shipment received\"\n}"
},
"url": "{{baseUrl}}/products/{{productId}}/stock-movements"
}
}
]
},
{
"name": "Sales Challans",
"item": [
{
"name": "List challans",
"request": {
"method": "GET",
"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
"url": "{{baseUrl}}/challans?page=1&limit=20&search=&status="
}
},
{
"name": "Create challan (Draft)",
"request": {
"method": "POST",
"header": [
{ "key": "Content-Type", "value": "application/json" },
{ "key": "Authorization", "value": "Bearer {{token}}" }
],
"body": {
"mode": "raw",
"raw": "{\n \"customerId\": \"{{customerId}}\",\n \"status\": \"DRAFT\",\n \"items\": [\n { \"productId\": \"{{productId}}\", \"quantity\": 5 }\n ]\n}"
},
"url": "{{baseUrl}}/challans"
}
},
{
"name": "Create challan (Confirmed - deducts stock immediately)",
"request": {
"method": "POST",
"header": [
{ "key": "Content-Type", "value": "application/json" },
{ "key": "Authorization", "value": "Bearer {{token}}" }
],
"body": {
"mode": "raw",
"raw": "{\n \"customerId\": \"{{customerId}}\",\n \"status\": \"CONFIRMED\",\n \"items\": [\n { \"productId\": \"{{productId}}\", \"quantity\": 5 }\n ]\n}"
},
"url": "{{baseUrl}}/challans"
}
},
{
"name": "Get challan detail",
"request": {
"method": "GET",
"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
"url": "{{baseUrl}}/challans/{{challanId}}"
}
},
{
"name": "Confirm draft challan (deducts stock)",
"request": {
"method": "PATCH",
"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
"url": "{{baseUrl}}/challans/{{challanId}}/confirm"

}
},
{
"name": "Cancel draft challan",
"request": {
"method": "PATCH",
"header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
"url": "{{baseUrl}}/challans/{{challanId}}/cancel"
}
}
]
}
]
}
